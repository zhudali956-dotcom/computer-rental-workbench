{
  "name": "rental-ops-workbench",
  "version": "0.1.0",
  "description": "面向电脑租赁团队的内网销售与内容运营工作台",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "build": "node server/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "feishu:test": "node --env-file=.env.feishu-test server/index.mjs --feishu-test",
    "test": "node --test",
    "test:browser": "node checks/browser.mjs && node checks/content-browser.mjs && node checks/xhs-draft-browser.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.17"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1"
  }
}
